---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7358216103160669" crossorigin="anonymous"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10182d" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #f2f5fb;
    background: #10182d;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    --ink: #f2f5fb;
    --muted: #b8c2d7;
    --surface: #18243a;
    --surface-raised: #1d2c46;
    --line: #33445f;
    --blue: #a9ceff;
    --mint: #b5f1dc;
    --wrap: 1160px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 6rem; }
  body { min-width: 320px; margin: 0; background: radial-gradient(ellipse at 50% -28rem, #293c68 0, #10182d 52rem); }
  a { color: var(--blue); text-underline-offset: .22em; }
  a:hover { color: #d2e4ff; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--mint); outline-offset: 4px; border-radius: .2rem; }
  img, svg { max-width: 100%; }
  ::selection { color: #10182d; background: var(--mint); }
  .skip-link { position: fixed; z-index: 20; top: 1rem; left: 1rem; padding: .8rem 1rem; transform: translateY(-160%); border-radius: .65rem; background: var(--mint); color: #10182d; font-weight: 750; }
  .skip-link:focus { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
